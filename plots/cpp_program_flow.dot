digraph cpp_program_flow {
  rankdir=TB;
  graph [fontname="Helvetica", bgcolor="white", pad="0.2"];
  node [shape=box, style="rounded,filled", fillcolor="#F7F7F7", color="#333333", fontname="Helvetica", fontsize=11];
  edge [color="#333333", fontname="Helvetica", fontsize=10];

  start [shape=oval, fillcolor="#E8F5E9", label="Start\nmain(argc, argv)"];
  create [label="Create DevicePlatformHandlerOpenCL\n(new)"];
  call [label="Call isPlatformAvailable()"];
  query [label="clGetPlatformIDs(0, NULL, &numPlatforms)"];
  decision [shape=diamond, fillcolor="#FFF8E1", label="errNum != CL_SUCCESS\nor numPlatforms <= 0?"];
  fail [label="Print to stderr:\n\"Failed to find any OpenCL platform.\"\nreturn false"];
  ok [label="Print to stdout:\n\"Found OpenCL platform.\"\nreturn true"];
  cleanup [label="Delete DevicePlatformHandlerOpenCL"];
  end [shape=oval, fillcolor="#E3F2FD", label="Return 0\nEnd"];

  start -> create -> call -> query -> decision;
  decision -> fail [label="Yes"];
  decision -> ok [label="No"];
  fail -> cleanup;
  ok -> cleanup;
  cleanup -> end;
}
